# Optional settings for `make dev`: copy to .env (never commit it).

# Who you are locally, and make yourself an admin.
DEV_USER_EMAIL=you@example.com
APP_ADMIN_EMAILS=you@example.com

# The agent. Without LLM_ENDPOINT every run kind uses the fake agent: deterministic, no model calls.
# FAKE_AGENT_STEP_SECONDS=1           # pause per step, so you can watch the progress in the UI
# FAKE_AGENT_FAIL_AT=drafting_fields  # make runs fail at that step
# FAKE_AGENT_DRIFT="[v2] "            # prefix outputs, to check the UI shows what the agent sent

# The real agent: a CLI profile for the workspace and a Model Serving endpoint in it.
# DATABRICKS_CONFIG_PROFILE=<profile>
# LLM_ENDPOINT=<serving-endpoint-name>
# LLM_TEMPERATURE=0.2                         # only for models that accept it (recent Claude models don't)
# AGENT_RUNNER_OVERRIDES=assistant_turn=fake  # mix runners per run kind

# Call a separately running agent (`make agent`) instead of the in-process one.
# AGENT_TRANSPORT=http
# AGENT_API_BASE=http://localhost:9000
