# Optional settings for `make dev`: copy to .env (never commit it).

# Who you are locally, and make yourself an admin.
DEV_USER_EMAIL=you@example.com
APP_ADMIN_EMAILS=you@example.com

# Use the assistant agent locally: a CLI profile for the workspace and a Model Serving endpoint in it.
# DATABRICKS_CONFIG_PROFILE=<profile>
# LLM_ENDPOINT=<serving-endpoint-name>
